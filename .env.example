# Copier ce fichier en .env puis remplir les valeurs

# Clé de signature des sessions Flask (une longue chaîne aléatoire)
# Générer : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Clé API Anthropic (extraction des CV et questions d'entretien, utilisée pour les tests)
# Sans clé, l'application fonctionne avec l'extraction par règles.
ANTHROPIC_API_KEY=

# Envoi d'e-mails (réinitialisation de mot de passe, notifications) - facultatif
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Base de données - facultatif (SQLite recrut.db par défaut)
# DATABASE_URL=postgresql://utilisateur:motdepasse@localhost:5432/recrutia

# Bouton "Accès démo" sur la page de connexion (1 = activé, 0 = désactivé)
DEMO_MODE=1
